#!/bin/bash
# Run a command on the phone over ssh.
#   ~/a51-sfos-port/ssh/a51 'command'
# Host defaults to the WLAN address; override with A51_HOST.
# No default: the phone's address changes on every install.
HOST=${A51_HOST:?set A51_HOST to the phone's WLAN address}
USER_=${A51_USER:-defaultuser}
export A51_PASS=${A51_PASS:?set A51_PASS to the developer-mode password}
export SSH_ASKPASS=~/a51-sfos-port/ssh/askpass.sh
export SSH_ASKPASS_REQUIRE=force
export DISPLAY=:0
setsid -w ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=8 -o LogLevel=ERROR \
    "$USER_@$HOST" "$@" 2>&1
