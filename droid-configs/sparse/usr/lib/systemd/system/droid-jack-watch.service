[Unit]
Description=Switch audio route on headset jack insert/remove
After=droid-audio-route.service
Requires=droid-audio-route.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/bin/droid/droid-jack-watch.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
