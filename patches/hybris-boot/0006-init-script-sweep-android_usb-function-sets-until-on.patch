From 3e92d00b201139bfde3edd4a3f88a54acde22904 Mon Sep 17 00:00:00 2001
From: mostlys4nny <mostlys4nny@gmail.com>
Date: Fri, 21 Aug 2026 01:14:05 +0300
Subject: [PATCH 06/14] init-script: sweep android_usb function sets until one
 enables

On Exynos 9611 Samsung stores the requested list ('Function stored :
rndis,mass_storage') but the gadget stays DISCONNECTED with the UDC 'not
attached', and reading functions back yields an empty string - the enable
was rejected. mass_storage without a backing LUN is a likely culprit.

Try the requested set, then rndis, ncm and mtp alone, logging the resulting
functions/state/udc for each, and stop as soon as a usb0/rndis0 interface
appears.
---
 init-script | 30 ++++++++++++++++++++++++++----
 1 file changed, 26 insertions(+), 4 deletions(-)

diff --git a/init-script b/init-script
index 4c1fa32..5279b78 100755
--- a/init-script
+++ b/init-script
@@ -301,10 +301,32 @@ usb_setup_android_usb() {
     write $ANDROID_USB/iManufacturer   "Mer Boat Loader"
     write $ANDROID_USB/iProduct        "$CUSTOMPRODUCT"
     write $ANDROID_USB/iSerial         "$1"
-    write $ANDROID_USB/functions       $USB_FUNCTIONS
-    write $ANDROID_USB/enable          1
-    klog "android_usb: functions=$(cat $ANDROID_USB/functions 2>/dev/null) state=$(cat $ANDROID_USB/state 2>/dev/null)"
-    klog "udc state: $(cat /sys/class/udc/*/state 2>/dev/null | head -1)"
+    # Samsung accepts the function list ("Function stored : rndis,mass_storage")
+    # but can still refuse to enable the gadget, e.g. when mass_storage has no
+    # backing LUN. Try progressively simpler sets and keep the first that comes up.
+    for fset in "$USB_FUNCTIONS" rndis ncm mtp; do
+        [ -n "$fset" ] || continue
+        write $ANDROID_USB/enable    0
+        write $ANDROID_USB/functions "$fset"
+        if ! echo 1 > $ANDROID_USB/enable 2>/dev/null; then
+            klog "enable write REFUSED for '$fset'"
+            continue
+        fi
+        usleep 300000
+        st=$(cat $ANDROID_USB/state 2>/dev/null)
+        rb=$(cat $ANDROID_USB/functions 2>/dev/null)
+        ud=$(cat /sys/class/udc/*/state 2>/dev/null | head -1)
+        ifs=$(ls /sys/class/net 2>/dev/null | tr '\n' ' ')
+        klog "tried '$fset' -> functions='$rb' state=$st udc=$ud"
+        case "$ifs" in
+            *usb0*|*rndis0*)
+                klog "SUCCESS with '$fset', ifaces: $ifs"
+                USB_FUNCTIONS="$fset"
+                return 0
+                ;;
+        esac
+    done
+    klog "no function set brought up a USB network interface"
     klog "net ifaces: $(ls /sys/class/net 2>/dev/null | tr '\n' ' ')"
 }
 
