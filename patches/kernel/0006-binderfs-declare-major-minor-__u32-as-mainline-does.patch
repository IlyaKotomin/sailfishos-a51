From 5f7a39e43b11b098f38274f87fd103fed07ba3c0 Mon Sep 17 00:00:00 2001
From: mostlys4nny <mostlys4nny@gmail.com>
Date: Fri, 21 Aug 2026 22:54:59 +0300
Subject: [PATCH 6/8] binderfs: declare major/minor __u32 as mainline does

Samsung declared struct binderfs_device with __u8 major/minor. That makes
sizeof() 258 rather than 264, so BINDER_CTL_ADD encodes a different ioctl
number than every userspace built against the real UAPI header, and allocating
a binder device fails with EINVAL. Waydroid cannot create its own binder nodes
because of this, and AOSP's init would hit the same wall. __u8 also truncates
the major number, which is 510 on this device.
---
 include/uapi/linux/android/binderfs.h | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/include/uapi/linux/android/binderfs.h b/include/uapi/linux/android/binderfs.h
index 65b2efd1a0a5..a29f7812b600 100644
--- a/include/uapi/linux/android/binderfs.h
+++ b/include/uapi/linux/android/binderfs.h
@@ -22,8 +22,16 @@
  */
 struct binderfs_device {
 	char name[BINDERFS_MAX_NAME + 1];
-	__u8 major;
-	__u8 minor;
+	/*
+	 * Mainline and AOSP both declare these __u32. Samsung shipped them as
+	 * __u8, which makes sizeof(struct binderfs_device) 258 instead of 264
+	 * and therefore encodes a different BINDER_CTL_ADD ioctl number, so
+	 * every userspace built against the real UAPI header - Waydroid, and
+	 * AOSP's own init - gets EINVAL when it tries to allocate a binder
+	 * device. __u8 also truncates the major number, which is 510 here.
+	 */
+	__u32 major;
+	__u32 minor;
 };
 
